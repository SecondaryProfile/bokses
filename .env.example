# Copy this file to .env and change the password before the first start:
#
#   cp .env.example .env
#
# Bokses refuses to start while the password is still "change-me".
# Pick something long and random, e.g. the output of:  openssl rand -base64 24
#
# The password is set when the database is first created. Changing it here
# later will NOT change it inside an existing database.
POSTGRES_PASSWORD=change-me

# Port Bokses is served on. Open http://localhost:6692 (or this machine's IP)
BOKSES_PORT=6692
